# Exoscale API Credentials
# Get these from: https://portal.exoscale.com/account/profile/api

EXOSCALE_API_KEY=your-api-key-here
EXOSCALE_API_SECRET=your-api-secret-here

# Optional: Deployment Configuration
EXOSCALE_ZONE=ch-gva-2

# For Production Deployment Only
ORGANIZATION_NAME=er1  # Options: er1, er2, er3
FORTIGATE_PUBLIC_IP=your-fortigate-public-ip
PRIVATE_INSTANCE_COUNT=2

# For Test Deployments Only  
ORG_NAME=test-org
INSTANCE_COUNT=2